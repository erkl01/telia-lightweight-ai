---
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Ett lättviktigt Telia-prototypprojekt byggt med Astro." } = Astro.props;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F5FA" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
