---
type Variant = "primary" | "secondary" | "expressive" | "text";
type ButtonType = "button" | "submit" | "reset";

interface Props {
  variant?: Variant;
  type?: ButtonType;
  href?: string;
  disabled?: boolean;
  class?: string;
}

const {
  variant = "primary",
  type = "button",
  href,
  disabled = false,
  class: className,
} = Astro.props;
---

{
  href ? (
    <a
      class:list={["button", `button--${variant}`, className]}
      href={disabled ? undefined : href}
      aria-disabled={disabled ? "true" : undefined}
      tabindex={disabled ? -1 : undefined}
    >
      <slot />
    </a>
  ) : (
    <button
      class:list={["button", `button--${variant}`, className]}
      type={type}
      disabled={disabled}
    >
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border: 0;
    border-radius: var(--radius-full);
    color: inherit;
    font-weight: 500;
    line-height: 1.5rem;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .button :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .button:disabled,
  .button[aria-disabled="true"] {
    background: var(--color-interactive-disabled-background);
    box-shadow: none;
    color: var(--color-interactive-disabled-text);
    cursor: not-allowed;
    pointer-events: none;
  }

  .button--primary {
    background: var(--color-interactive-primary);
    color: var(--color-white);
  }

  .button--primary:hover:not(:disabled):not([aria-disabled="true"]) {
    background: var(--color-interactive-primary-hover);
  }

  .button--primary:active:not(:disabled):not([aria-disabled="true"]) {
    background: var(--color-interactive-primary-active);
  }

  .button--secondary {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--color-interactive-primary);
    color: var(--color-interactive-text);
  }

  .button--secondary:hover:not(:disabled):not([aria-disabled="true"]),
  .button--text:hover:not(:disabled):not([aria-disabled="true"]) {
    background: var(--color-interactive-surface-hover);
  }

  .button--secondary:active:not(:disabled):not([aria-disabled="true"]),
  .button--text:active:not(:disabled):not([aria-disabled="true"]) {
    background: var(--color-interactive-surface-active);
  }

  .button--expressive {
    background: var(--color-interactive-expressive);
    color: var(--color-white);
  }

  .button--expressive:hover:not(:disabled):not([aria-disabled="true"]) {
    background: var(--color-interactive-expressive-hover);
  }

  .button--expressive:active:not(:disabled):not([aria-disabled="true"]) {
    background: var(--color-interactive-expressive-active);
  }

  .button--text {
    background: transparent;
    color: var(--color-interactive-text);
    padding-inline: 0;
  }
</style>
