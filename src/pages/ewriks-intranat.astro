---
import Layout from "../layouts/Layout.astro";
import Input from "../components/Input.astro";
import logo from "../assets/telia/telia-logos/telia-pebble-lightmode.svg";
import arrowRight from "../assets/icons/purpur/arrow-right.svg?raw";

const sections = [
  {
    title: "Kom igång",
    links: ["Välkommen till företaget", "Din första vecka", "Checklista för nyanställda", "IT-utrustning och konton", "Få tillgång till system", "Träffa teamet", "Vanliga frågor"],
  },
  {
    title: "Mitt arbete",
    links: ["Tidrapportering", "Semester och ledighet", "Reseräkningar", "Lön och förmåner", "Mina mål och utveckling", "Boka möteslokal", "Min kalender"],
  },
  {
    title: "Team och organisation",
    links: ["Organisationsschema", "Personalkatalog", "Avdelningar", "Ledningsgrupp", "Lediga tjänster", "Interna nyheter", "Evenemang"],
  },
  {
    title: "Verktyg och system",
    links: ["Ärendehantering", "Projektverktyg", "Dokumentarkiv", "Chatt och videomöten", "Inköp och beställning", "Rapporter och statistik", "Mallar och grafisk profil"],
  },
  {
    title: "Support och policys",
    links: ["IT-support", "HR-support", "Säkerhet och dataskydd", "Policys och riktlinjer", "Rapportera en incident", "Arbetsmiljö", "Kontakta oss"],
  },
];
---

<Layout title="EWriks intranät – Telia prototyp" description="Enkel startsida med snabblänkar till vanliga delar av intranätet.">
  <header class="topbar">
    <div class="topbar__inner">
      <a class="brand" href="/ewriks-intranat">
        <img class="brand__logo" src={logo.src} alt="Logotyp" width="32" height="32" />
        <span class="brand__name">EWriks intranät</span>
      </a>
      <form class="search" role="search" onsubmit="return false">
        <Input label="Sök på intranätet" name="q" type="search" placeholder="Sök på intranätet" />
      </form>
    </div>
  </header>

  <main class="page">
    <h1 class="page__title">Välkommen till EWriks intranät</h1>
    <p class="page__lead">Här hittar du snabbt till det du behöver i vardagen.</p>

    <div class="grid">
      {sections.map((section) => (
        <section class="card">
          <h2 class="card__title">{section.title}</h2>
          <ul class="card__list">
            {section.links.map((label) => (
              <li>
                <a class="link" href="#">
                  <span>{label}</span>
                  <span class="link__icon" aria-hidden="true" set:html={arrowRight} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</Layout>

<style>
  .topbar {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .topbar__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
  }
  .brand__logo {
    display: block;
    height: 2rem;
    width: auto;
  }
  .brand__name {
    font-family: var(--font-family-display);
    font-size: var(--font-size-lg);
    font-weight: 700;
  }
  .search {
    flex: 0 1 22rem;
    min-width: 14rem;
  }
  .search :global(.field__label) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .page {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-16);
  }
  .page__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-family-display);
    font-size: var(--font-size-display);
    line-height: var(--line-height-default);
  }
  .page__lead {
    margin: 0 0 var(--space-12);
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
  }
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .card__title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    line-height: var(--line-height-default);
  }
  .card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-2);
    border-radius: var(--radius-md);
    color: var(--color-interactive-text);
    text-decoration: none;
  }
  .link:hover {
    background: var(--color-interactive-surface-hover);
    color: var(--color-interactive-text-hover);
  }
  .link:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }
  .link__icon {
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }
  .link__icon :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
</style>
